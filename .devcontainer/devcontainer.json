{
  "name": "İlan Şehri Django",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash scripts/start_codespace.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "İlan Şehri Önizleme",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "batisteo.vscode-django"
      ]
    }
  }
}
