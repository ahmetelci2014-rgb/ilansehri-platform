DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTO_PUBLISH_LISTINGS=False
VERIFICATION_DEBUG_CODE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DEFAULT_FROM_EMAIL=İlan Şehri <noreply@ilansehri.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Canlı telefon doğrulaması için JSON webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Canlı alan adı (sitemap, robots ve paylaşım bağlantıları için)
PUBLIC_BASE_URL=

# Yapay Zekâ ile İlan Hazırla (v1.12.2.1 Gemini görsel analiz)
# API anahtarını kaynak koda veya GitHub'a yüklemeyin; yalnız sunucu .env dosyasında tutun.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_REVISION=2026-05-20
GEMINI_MODEL=gemini-3.6-flash
# Yedek OpenAI sağlayıcısı (zorunlu değildir):
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_PROJECT_ID=
AI_LISTING_MODEL=
# Alternatif, kendi JSON görsel servisiniz için:
AI_LISTING_API_URL=
AI_LISTING_API_KEY=
